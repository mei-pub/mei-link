{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meilink",
  "version": "1.1.0",
  "identifier": "pub.mei.meilink.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:17420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "url": "popover.html",
        "title": "",
        "width": 330,
        "height": 440,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "transparent": true
      },
      {
        "label": "main",
        "url": "main.html",
        "title": "Meilink",
        "width": 1060,
        "height": 820,
        "minWidth": 980,
        "minHeight": 740,
        "visible": false,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "设置",
        "width": 760,
        "height": 737,
        "visible": false,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "setup",
        "url": "setup.html",
        "title": "首次配置",
        "width": 560,
        "height": 597,
        "resizable": false,
        "visible": false,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "tunnel-edit",
        "url": "tunnel-edit.html",
        "title": "隧道",
        "width": 660,
        "height": 565,
        "minWidth": 600,
        "minHeight": 505,
        "visible": false,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "logs",
        "url": "logs.html",
        "title": "日志",
        "width": 820,
        "height": 620,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'module'; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/meilink"],
    "resources": {},
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
