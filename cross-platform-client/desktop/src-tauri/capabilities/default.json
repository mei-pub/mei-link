{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Meilink desktop",
  "windows": ["popover", "main", "settings", "setup", "tunnel-edit", "logs"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:app:allow-set-dock-visibility",
    "core:tray:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open",
    "shell:allow-kill",
    "positioner:default",
    "positioner:allow-move-window"
  ]
}
